# MongoDB connection string (local Docker or MongoDB Atlas)
MONGODB_URI="mongodb://localhost:27017/mentorque"
JWT_SECRET="replace-with-a-long-random-secret"
GEMINI_API_KEY="your-free-google-ai-studio-key"
GEMINI_MODEL="gemini-3.1-flash-lite"
# Emails that can open /admin (comma-separated for more than one admin)
